# GenBI Wren/ibis compose — copy to .env and adjust if needed.
# No vector DB settings here: Wren indexes use the app Postgres (pgvector).

IBIS_SERVER_VERSION=0.22.0
WREN_ENGINE_VERSION=0.22.0

# Host ports (localhost-bound in compose)
GENBI_IBIS_HOST_PORT=18000
GENBI_WREN_ENGINE_HOST_PORT=8080

# In-compose ibis → engine (service DNS). Override only for unusual layouts.
GENBI_WREN_ENGINE_ENDPOINT=http://genbi-wren-engine:8080
